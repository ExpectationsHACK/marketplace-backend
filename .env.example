# Copy to .env and adjust. The server checks these at startup and lists every problem.

# SQLite file for local development. For Postgres, switch the datasource in
# prisma/schema.prisma and the adapter in src/prisma/prisma.service.ts (see README).
DATABASE_URL="file:./dev.db"

PORT=4000

# Allowed CORS origins, comma-separated (the Next.js frontend).
FRONTEND_ORIGIN="http://localhost:3000"

# Prefix for upload URLs in API responses. Defaults to http://localhost:$PORT.
# PUBLIC_BASE_URL="https://api.example.com"

# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string-of-32-plus-chars"
JWT_EXPIRES_IN="7d"

# No SMS provider is connected yet: codes are written to the server log.
# true also returns the code in the API response, for local development.
# The server refuses to start with this enabled when NODE_ENV=production.
OTP_DEV_ECHO=true

# Where uploaded photos and ID documents are stored on disk.
UPLOAD_DIR="./uploads"

# Which proxies may set X-Forwarded-For. The Next.js app calls this API for the
# browser and forwards the client IP, which the rate limiter keys on. Keep this to
# the hops you run (default: loopback, for the web app on the same machine).
TRUST_PROXY=loopback

# ID documents and selfies. Must not be UPLOAD_DIR or inside it (the server refuses).
PRIVATE_UPLOAD_DIR="./private-uploads"

# Swagger UI at /api/docs. Defaults to on, except when NODE_ENV=production.
# SWAGGER_ENABLED=false
